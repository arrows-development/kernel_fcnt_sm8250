		cci-master = <1>;
		status = "ok";
		clocks = <&clock_camcc 0x4f>;
		clock-names = "cam_clk";
		clock-cntl-level = "turbo";
		clock-rates = <0x16e3600>;
	};
};

&qupv3_se15_i2c {
	stmvl53l1: stmvl53l1@29 {
		compatible = "st,stmvl53l1";
		reg = <0x29>;
		vdd-supply = <&pm8150_l16>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_tof_int_active &cam_tof_reset_active>;
		pinctrl-1 = <&cam_tof_int_suspend &cam_tof_reset_suspend>;
		xsdn-gpio = <&tlmm 62 0>;
		intr-gpio = <&tlmm 64 0>;
		vdd-min-microvolt = <2800000>;
		vdd-max-microvolt = <3304000>;
		vdd-threshold-currents = <10000>;
	};
};
