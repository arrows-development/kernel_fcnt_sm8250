/*
 * FCNT arrows 5G (F-51A) - Fingerprint: QBT handler (ipc and finger-detect lines).
 *
 * Reconstructed from the FCNT stock dtbo (kona FFRD REV7 SKU3); FFRD is
 * derived from the CLO kona QRD board files.
 */

&soc {
	qbt_handler: qcom,qbt_handler {
		compatible = "qcom,qbt-handler";
		qcom,ipc-gpio = <&tlmm 23 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&fp_detect_default>;
#ifndef AMATERASU_NO_FP_DETECT
		qcom,finger-detect-gpio = <&pm8150_gpios 1 0>;
#endif
	};
};
