/*
 * FCNT arrows 5G (F-51A) - Thermal: ADC thermistor channels, FCNT thermal zones and mitigation.
 *
 * Reconstructed from the FCNT stock dtbo (kona FFRD REV7 SKU3); FFRD is
 * derived from the CLO kona QRD board files.
 */

&pm8150_vadc {
	vph_pwr@83 {
		reg = <0x83>;
		label = "vph_pwr";
		qcom,pre-scaling = <1 3>;
	};

	vcoin@85 {
		reg = <0x85>;
		label = "vcoin";
		qcom,pre-scaling = <1 3>;
	};

	xo_therm@4c {
		reg = <0x4c>;
		label = "xo_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	skin_therm@4d {
		reg = <0x4d>;
		label = "skin_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	pa_therm1@4e {
		reg = <0x4e>;
		label = "pa_therm1";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm8150_adc_tm {
	io-channels = <&pm8150_vadc 76 &pm8150_vadc 77 &pm8150_vadc 78>;

	xo_therm@4c {
		reg = <0x4c>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	skin_therm@4d {
		reg = <0x4d>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	pa_therm1@4e {
		reg = <0x4e>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};
};

&pm8150b_vadc {
	vph_pwr@83 {
		reg = <0x83>;
		label = "vph_pwr";
		qcom,pre-scaling = <1 3>;
	};

	conn_therm@4f {
		reg = <0x4f>;
		label = "conn_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	chg_sbux@99 {
		reg = <0x99>;
		label = "chg_sbux";
		qcom,pre-scaling = <1 3>;
	};

	mid_chg_div6@1e {
		reg = <0x1e>;
		label = "chg_mid";
		qcom,pre-scaling = <1 6>;
	};

	usb_in_i_uv@7 {
		reg = <0x7>;
		label = "usb_in_i_uv";
		qcom,pre-scaling = <1 1>;
	};

	usb_in_v_div_16@8 {
		reg = <0x8>;
		label = "usb_in_v_div_16";
		qcom,pre-scaling = <1 16>;
	};

	qtm_right_therm@4d {
		reg = <0x4d>;
		label = "qtm_right_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm8150b_adc_tm {
	io-channels = <&pm8150b_vadc 79 &pm8150b_vadc 77>;

	conn_therm@4f {
		reg = <0x4f>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	qtm_right_therm@4d {
		reg = <0x4d>;
		label = "qtm_right_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};
};

&pm8150l_vadc {
	vph_pwr@83 {
		reg = <0x83>;
		label = "vph_pwr";
		qcom,pre-scaling = <1 3>;
	};

	camera_flash_therm@4d {
		reg = <0x4d>;
		label = "camera_flash_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	skin_msm_therm@4e {
		reg = <0x4e>;
		label = "skin_msm_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};

	pa_therm2@4f {
		reg = <0x4f>;
		label = "pa_therm2";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&pm8150l_adc_tm {
	camera_flash_therm@4d {
		reg = <0x4d>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	skin_msm_therm@4e {
		reg = <0x4e>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};

	pa_therm2@4f {
		reg = <0x4f>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};
};

&thermal_zones {
	conn-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150b_adc_tm 79>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	xo-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150_adc_tm 76>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	skin-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150_adc_tm 77>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	mmw-pa1-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150_adc_tm 78>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	camera-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150l_adc_tm 77>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	skin-msm-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150l_adc_tm 78>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			/* upstream a2dceb359e01: trip for the second userspace client */
			active-config1 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	mmw-pa2-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150l_adc_tm 79>;
		wake-capable-sensor;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	gpu-skin-avg-step {
		polling-delay-passive = <1000>;
		polling-delay = <5000>;
		thermal-governor = "step_wise";
		disable-thermal-zone;

		trips {
			virt_trip: virt-trip {
				temperature = <64600>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {
			gpu_cdev {
				trip = <&virt_trip>;
				cooling-device = <&msm_gpu 0 1>;
			};
		};
	};

	skin-msm-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150l_adc_tm 78>;
		wake-capable-sensor;
		disable-thermal-zone;

		trips {
			skin_trip: skin-config0 {
				temperature = <46000>;
				hysteresis = <0>;
				type = "passive";
			};
		};

		cooling-maps {
			lcd_cdev {
				trip = <&skin_trip>;
				cooling-device = <&mdss_mdp 153 153>;
			};
		};
	};

	xo-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150_adc_tm 76>;
		disable-thermal-zone;

		trips {
			xo_lvl0: active-config0 {
				temperature = <42000>;
				hysteresis = <2000>;
				type = "passive";
			};

			xo_lvl1: active-config1 {
				temperature = <46000>;
				hysteresis = <2000>;
				type = "passive";
			};

			xo_lvl2: active-config2 {
				temperature = <56000>;
				hysteresis = <6000>;
				type = "passive";
			};
		};

		cooling-maps {
			xo_skin_lvl0 {
				trip = <&xo_lvl0>;
				cooling-device = <&modem_mmw_skin2 1 1>;
			};

			xo_skin_lvl1 {
				trip = <&xo_lvl1>;
				cooling-device = <&modem_mmw_skin2 2 2>;
			};

			xo_skin_lvl2 {
				trip = <&xo_lvl2>;
				cooling-device = <&modem_mmw_skin2 3 3>;
			};
		};
	};

	mmw-pa1-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150_adc_tm 78>;
		disable-thermal-zone;

		trips {
			pa1_lvl0: active-config0 {
				temperature = <44000>;
				hysteresis = <5000>;
				type = "passive";
			};

			pa1_lvl1: active-config1 {
				temperature = <48000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pa1_lvl2: active-config2 {
				temperature = <56000>;
				hysteresis = <6000>;
				type = "passive";
			};
		};

		cooling-maps {
			pa1_skin_lvl0 {
				trip = <&pa1_lvl0>;
				cooling-device = <&modem_mmw_skin0 1 1>;
			};

			pa1_skin_lvl1 {
				trip = <&pa1_lvl1>;
				cooling-device = <&modem_mmw_skin0 2 2>;
			};

			pa1_skin_lvl2 {
				trip = <&pa1_lvl2>;
				cooling-device = <&modem_mmw_skin0 3 3>;
			};
		};
	};

	mmw-pa2-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150l_adc_tm 79>;
		disable-thermal-zone;

		trips {
			pa2_lvl0: active-config0 {
				temperature = <42000>;
				hysteresis = <4000>;
				type = "passive";
			};

			pa2_lvl1: active-config1 {
				temperature = <46000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pa2_lvl2: active-config2 {
				temperature = <56000>;
				hysteresis = <6000>;
				type = "passive";
			};
		};

		cooling-maps {
			pa2_skin_lvl0 {
				trip = <&pa2_lvl0>;
				cooling-device = <&modem_mmw_skin1 1 1>;
			};

			pa2_skin_lvl1 {
				trip = <&pa2_lvl1>;
				cooling-device = <&modem_mmw_skin1 2 2>;
			};

			pa2_skin_lvl2 {
				trip = <&pa2_lvl2>;
				cooling-device = <&modem_mmw_skin1 3 3>;
			};
		};
	};

	skin-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150_adc_tm 77>;
		wake-capable-sensor;
		disable-thermal-zone;

		trips {
			skin_therm0: active-config0 {
				temperature = <52000>;
				hysteresis = <5000>;
				type = "passive";
			};

			skin_therm1: active-config1 {
				temperature = <55000>;
				hysteresis = <5000>;
				type = "passive";
			};

			skin_therm2: active-config2 {
				temperature = <62000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {
			skin_lvl0 {
				trip = <&skin_therm0>;
				cooling-device = <&modem_skin 1 1>;
			};

			skin_lvl1 {
				trip = <&skin_therm1>;
				cooling-device = <&modem_skin 2 2>;
			};

			skin_lvl2 {
				trip = <&skin_therm2>;
				cooling-device = <&modem_skin 3 3>;
			};
		};
	};

	qtm-right-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150b_adc_tm 77>;

		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	SDM_SKIN_THERM {
		polling-delay-passive = <1000>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150l_adc_tm 78>;
		wake-capable-sensor;

		trips {
			SDM_SKIN_THERM_trip_point0: SDM_SKIN_THERM_trip0 {
				temperature = <40000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point1: SDM_SKIN_THERM_trip1 {
				temperature = <43000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point2: SDM_SKIN_THERM_trip2 {
				temperature = <45000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point3: SDM_SKIN_THERM_trip3 {
				temperature = <47000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point4: SDM_SKIN_THERM_trip4 {
				temperature = <50000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point5: SDM_SKIN_THERM_trip5 {
				temperature = <53000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point6: SDM_SKIN_THERM_trip6 {
				temperature = <55000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point7: SDM_SKIN_THERM_trip7 {
				temperature = <56000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point8: SDM_SKIN_THERM_trip8 {
				temperature = <58000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point9: SDM_SKIN_THERM_trip9 {
				temperature = <59000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point10: SDM_SKIN_THERM_trip10 {
				temperature = <60000>;
				hysteresis = <1000>;
				type = "passive";
			};

			SDM_SKIN_THERM_trip_point11: SDM_SKIN_THERM_trip11 {
				temperature = <60000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};

		cooling-maps {
			SDM_SKIN_THERM_cpu0_freq_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&CPU0 (-1) 0>;
			};

			SDM_SKIN_THERM_cpu4_freq_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&CPU4 (-1) 0>;
			};

			SDM_SKIN_THERM_cpu7_freq_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&CPU7 (-1) 10>;
			};

			SDM_SKIN_THERM_cpu0_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu0_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu1_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu1_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu2_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu2_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu3_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu3_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu4_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu4_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu5_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu5_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu6_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu6_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu7_isolate_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&cpu7_isolate 0 0>;
			};

			SDM_SKIN_THERM_gpu_freq_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
