			};

			SDM_SKIN_THERM_backlight_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&mdss_mdp 0 0>;
			};

			SDM_SKIN_THERM_oem_chg_trip0 {
				trip = <&SDM_SKIN_THERM_trip_point0>;
				cooling-device = <&oem_charger_drv 0 0>;
			};

			SDM_SKIN_THERM_cpu0_freq_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&CPU0 (-1) 0>;
			};

			SDM_SKIN_THERM_cpu4_freq_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&CPU4 (-1) 0>;
			};

			SDM_SKIN_THERM_cpu7_freq_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&CPU7 (-1) 19>;
			};

			SDM_SKIN_THERM_cpu0_isolate_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&cpu0_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu1_isolate_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&cpu1_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu2_isolate_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&cpu2_isolate 0 0>;
			};

			SDM_SKIN_THERM_cpu3_isolate_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
