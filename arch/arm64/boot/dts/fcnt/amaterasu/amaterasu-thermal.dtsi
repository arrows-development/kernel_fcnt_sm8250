			};

			SDM_SKIN_THERM_oem_chg_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&oem_charger_drv 0 0>;
			};

			SDM_SKIN_THERM_cpu0_freq_trip2 {
				trip = <&SDM_SKIN_THERM_trip_point2>;
				cooling-device = <&CPU0 (-1) 0>;
			};

			SDM_SKIN_THERM_cpu4_freq_trip2 {
				trip = <&SDM_SKIN_THERM_trip_point2>;
				cooling-device = <&CPU4 (-1) 1>;
			};

			SDM_SKIN_THERM_cpu7_freq_trip2 {
				trip = <&SDM_SKIN_THERM_trip_point2>;
				cooling-device = <&CPU7 (-1) 19>;
