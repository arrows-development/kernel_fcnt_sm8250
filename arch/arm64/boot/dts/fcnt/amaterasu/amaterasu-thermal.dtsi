			};

			SDM_SKIN_THERM_gpu_freq_trip1 {
				trip = <&SDM_SKIN_THERM_trip_point1>;
				cooling-device = <&msm_gpu 0 0>;
			};

			SDM_SKIN_THERM_backlight_trip1 {
