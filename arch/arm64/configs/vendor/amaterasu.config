# DTB
CONFIG_MACH_FCNT_AMATERASU=y
CONFIG_OF_IGNORE_QCOM_VENDOR_DTS=y

# Touchscreen
CONFIG_FB=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_V27=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_V27_I2C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_V27_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_V27_RMI_DEV=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DEVICE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TESTING=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_REFLASH=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_RECOVERY=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_ZEROFLASH=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DIAGNOSTICS=y
CONFIG_TOUCHSCREEN_PARADE=y
CONFIG_TOUCHSCREEN_PARADE_DEVICETREE_SUPPORT=y
CONFIG_TOUCHSCREEN_PARADE_I2C=y
CONFIG_TOUCHSCREEN_PARADE_MT_B=y
CONFIG_TOUCHSCREEN_PARADE_DEVICE_ACCESS=y
CONFIG_TOUCHSCREEN_PARADE_LOADER=y
CONFIG_TOUCHSCREEN_PARADE_BINARY_FW_UPGRADE=y
CONFIG_TOUCHSCREEN_PARADE_AOI_EVENT=y

# NFC
CONFIG_NFC=y
CONFIG_NFC_CXD224X=m
CONFIG_NFC_CXD224X_RST=m

# ToF sensor
CONFIG_INPUT_STMVL53L1=y

# WLAN (QCA6390)
CONFIG_QCA_CLD_WLAN=m
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"

# 11ad / WiGig
CONFIG_WIL6210=m
CONFIG_WIL6210_ISR_COR=y
CONFIG_WIL6210_PLATFORM_MSM=y
CONFIG_WIL6210_WRITE_IOCTL=y
CONFIG_WIL6210_IPA=y
CONFIG_MSM_11AD=m
CONFIG_WIGIG_SENSING_SPI=m

# DVB demux
CONFIG_DVB_MPQ=m
CONFIG_DVB_MPQ_DEMUX=m
CONFIG_DVB_MPQ_NUM_DMX_DEVICES=4
CONFIG_DVB_MPQ_SW=y

# Misc
CONFIG_MSM_RDBG=m
CONFIG_LCD_CLASS_DEVICE=m
CONFIG_QCOM_LLCC_PERFMON=m

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_SUMMARY=y
# CONFIG_PSTORE_FTRACE is not set
CONFIG_PSTORE_RAM=y

# fjdev-perf_defconfig
CONFIG_LOCALVERSION=""
# CONFIG_CORESIGHT is not set
# CONFIG_LOCKUP_DETECTOR is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
CONFIG_PANIC_ON_DATA_CORRUPTION=y
CONFIG_PANIC_ON_RT_THROTTLING=y
CONFIG_LOG_BUF_SHIFT=19
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_IP_MULTICAST=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_FJSEC=y
CONFIG_INET_XFRM_MODE_TRANSPORT=y
CONFIG_INET_XFRM_MODE_TUNNEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NLS_UTF8=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,fjsec,smack,tomoyo,apparmor,bpf"
